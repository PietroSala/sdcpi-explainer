# The software release, a loop over the rounds of review: the finding; the fix; the
# subprocess @tests beside the documentation.
(0.25 (Review, 1, {hours: 4}),
      ( (Major, 1, {hours: 6}) ^[0.4] (Minor, 1, {hours: 2}) ),
      ( (House, 2, {hours: 16}) ^ (Vendor, 3, {hours: 2, euro: 1500}) ),
      ( @tests[Tests] || (Docs, 2, {hours: 3}) ) ),
(Ship, 1, {hours: 4})
