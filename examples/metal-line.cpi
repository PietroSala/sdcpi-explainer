# The metal line, with its nine tasks: the sequences are bracketed to the right, the
# energy in kwh and the work in hours.
(Cut, 1, {kwh: 10, hours: 1}),
( ( ( (Bend, 1, {kwh: 20, hours: 1}), ( (HPol, 2, {kwh: 5, hours: 4}) ^[0.2] (LPol, 1, {kwh: 8, hours: 1}) ) )
    ||
    ( (Mill, 1, {kwh: 50, hours: 1}), ( (FDep, 1, {kwh: 30, hours: 1}) ^ (RDep, 1, {kwh: 10, hours: 1}) ) ) ),
  ( (HPHS, 1, {kwh: 40, hours: 1}) ^ (LPLS, 2, {kwh: 20, hours: 3}) ) )
